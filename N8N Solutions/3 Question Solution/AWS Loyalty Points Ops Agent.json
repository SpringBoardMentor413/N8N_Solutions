        "jsCode": "const workflowData = $getWorkflowStaticData('global'); const input = $input.first().json; const runId = input.pipeline_run_id; if (workflowData.pipeline_states?.[runId]) { workflowData.pipeline_states[runId].status = 'RESOLVED'; workflowData.pipeline_states[runId].resolved = true; workflowData.pipeline_states[runId].approved_by = input.body?.approved_by || 'engineer'; workflowData.pipeline_states[runId].resolved_at = new Date().toISOString(); } return [ { json: { status : 'RESOLVED', pipeline_run_id : runId, customer_id : input.customer_id, fix_action : input.fix_action, approved_by : input.body?.approved_by || 'engineer', resolved_at : new Date().toISOString() } } ];"
