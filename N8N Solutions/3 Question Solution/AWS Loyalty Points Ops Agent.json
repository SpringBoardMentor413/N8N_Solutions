      "parameters": {
        "jsCode": "const agentOutput = $input.first().json.output || '';\n\n// Detect if agent halted\nconst agentHalted = agentOutput.toLowerCase().includes('halt')\n  || agentOutput.toLowerCase().includes('cannot proceed')\n  || agentOutput.toLowerCase().includes('stopping');\n\n// Clean markdown symbols and extract sections\nconst lines = agentOutput.split('\\n');\n\nconst findSection = (keyword) => {\n  const idx = lines.findIndex(l =>\n    l.toLowerCase().includes(keyword.toLowerCase()));\n  return idx !== -1\n    ? lines.slice(idx, idx + 2).join(' ')\n        .replace(/[#*\\-]/g, '')\n        .trim()\n    : 'Not found';\n};\n\nconst rootCause   = findSection('root cause');\nconst fixAction   = findSection('deduct') \n                 || findSection('fix action')\n                 || findSection('specific fix');\nconst discrepancy = findSection('excess points')\n                 || findSection('discrepancy');\nconst checklist   = findSection('checklist');\n\n// Pull upstream context safely\nlet customer_id     = 'CUST-001';\nlet pipeline_run_id = 'RUN-001';\nlet issue_type      = 'DOUBLE_MULTIPLIER';\n\ntry {\n  const upstream  = $('Webhook').first().json.body;\n  customer_id     = upstream.customer_id     || customer_id;\n  pipeline_run_id = upstream.pipeline_run_id || pipeline_run_id;\n  issue_type      = upstream.issue_type      || issue_type;\n} catch(e) {\n  // upstream not available — use defaults above\n}\n\nreturn [\n  {\n    json: {\n      fix_proposal    : agentOutput,\n      root_cause      : rootCause,\n      fix_action      : fixAction,\n      discrepancy     : discrepancy,\n      checklist       : checklist,\n      agent_halted    : agentHalted,\n      customer_id     : customer_id,\n      pipeline_run_id : pipeline_run_id,\n      issue_type      : issue_type,\n      parsed_at       : new Date().toISOString()\n    }\n  }\n];"
      },
